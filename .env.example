# Frontend → Backend API
# Local: http://localhost:8000/api
# AWS (same-origin via API Gateway custom domain / reverse proxy): /api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Backend
PORT=8000
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Nova Canvas (virtual try-on)
BEDROCK_VTO_MODEL_ID=amazon.nova-canvas-v1:0

# Optional CORS lock for production frontend origin
# FRONTEND_ORIGIN=https://d123.cloudfront.net

# Auth for local Bedrock calls: use `aws configure` (do NOT commit keys).
# On AWS Lambda/ECS, use an IAM role with bedrock:InvokeModel — no keys in env.
